# Copy to .env in the repository root. Never commit real credentials.
# scripts/run_host.sh loads this file; Python does not implicitly load .env.
FLOWEROLL_HOST_TOKEN=
FLOWEROLL_PLANNER_API_KEY=
FLOWEROLL_PLANNER_BASE_URL=
FLOWEROLL_PLANNER_MODEL=
FLOWEROLL_PLANNER_MAX_COMPLETION_TOKENS=4000
# Optional independent observation/vision provider; otherwise uses configured fallbacks.
FLOWEROLL_OBSERVATION_API_KEY=
FLOWEROLL_OBSERVATION_BASE_URL=
FLOWEROLL_OBSERVATION_MODEL=
FLOWEROLL_OBSERVATION_VISION_API_KEY=
FLOWEROLL_OBSERVATION_VISION_BASE_URL=
FLOWEROLL_OBSERVATION_VISION_MODEL=
# Required when Planner is enabled. Deterministic tests need no real keys.
MEM0_API_KEY=
FLOWEROLL_MEM0_USER_ID=floweroll-owner
AMAP_MAPS_API_KEY=
FLYAI_API_KEY=
# FLOWEROLL_FLYAI_CLI=/absolute/path/to/flyai
FLOWEROLL_ENABLE_WEB_SEARCH=1
FLOWEROLL_ENABLE_CONTEXT7=0
# Local developer inspection is off in a fresh checkout.
FLOWEROLL_DEVELOPER_OBSERVABILITY=0
# FLOWEROLL_DB_PATH=work/floweroll-v1.sqlite3
# FLOWEROLL_HOST_WORKSPACE=work/host-capabilities
# FLOWEROLL_TASK_ASSET_ROOT=work/task-materials
# FLOWEROLL_MCP_SERVERS_JSON=
